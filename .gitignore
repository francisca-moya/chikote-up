# ------------------------------------------
# VARIABLES DE ENTORNO Y DATOS SENSIBLES
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# DEPENDENCIAS
# ------------------------------------------
/node_modules/
/vendor/

# ------------------------------------------
# LARAVEL
# ------------------------------------------
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*

/public/build/
/public/hot

# ------------------------------------------
# NODE.JS
# ------------------------------------------
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ------------------------------------------
# EDITORES Y ENTORNOS DE DESARROLLO
# ------------------------------------------
/.vscode/
/.idea/
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# SISTEMA OPERATIVO
# ------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------
# ARCHIVOS TEMPORALES Y LOGS
# ------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# ------------------------------------------
# BASE DE DATOS Y COPIAS TEMPORALES
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# ------------------------------------------
# ARCHIVOS DE MÁQUINAS VIRTUALES
# ------------------------------------------
*.vdi
*.vbox
*.vbox-prev
*.vmdk
*.vhd
*.vhdx
*.ova
*.ovf
